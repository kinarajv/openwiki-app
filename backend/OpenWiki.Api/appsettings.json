{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=openwiki.db"
  },
  "Cliproxy": {
    "ApiUrl": "http://192.168.0.44:8317",
    "FastModel": "gemini-3-flash-preview",
    "DeepModel": "gemini-3-flash-preview",
    "ApiKey": "sk-apikey"
  },
  "GITHUB_API_TOKEN": ""
}